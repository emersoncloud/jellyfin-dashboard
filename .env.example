# Jellyfin → Dashboard → API Keys → "+"
# URL as seen from inside the exporter container (Jellyfin on the same host)
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=

GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3030
GRAFANA_ANONYMOUS=true
PROMETHEUS_RETENTION=90d

# Used by the justfile from your machine (not by the containers)
UNRAID_HOST=root@your-server
JELLYFIN_REMOTE_URL=http://your-server:8096
